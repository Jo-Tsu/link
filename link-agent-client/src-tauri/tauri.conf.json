{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinkAgent",
  "version": "0.2.0",
  "identifier": "com.smallink.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LinkAgent",
        "width": 940,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Link 本地数据连接器客户端",
    "longDescription": "在本机安全运行连接器，并将用户授权的原始数据同步到 Link 平台。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
